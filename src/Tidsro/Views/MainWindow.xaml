<Window x:Class="Tidsro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Tidsro" Icon="pack://application:,,,/Assets/icons/tidsro.ico" Width="440" Height="600"
        MinWidth="380" MinHeight="480" ResizeMode="CanResize"
        Background="{StaticResource PageBg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource FontSans}">
  <Window.InputBindings>
    <!-- TabControl's own Ctrl+Tab only fires for keys routed through it; the header-only template
         puts Panels beside Tabs rather than inside it, so this has to be restored at the window level. -->
    <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding AdvanceTabCommand}"/>
  </Window.InputBindings>

  <Window.Resources>
    <!-- One cell of the wide Week grid: the entries that fall in one slot on one weekday, usually
         none. Factored into a style because the row template places seven of them by index and they
         have to be identical - seven copies of this markup inline is where they would drift apart.

         An empty cell generates no item containers, but the ItemsControl still publishes its OWN
         peer: a nameless list. Seven per row over nineteen rows measured as 133 lists in the UIA
         tree, 105 of them empty (2026-08-27). Collapsing an empty cell is what keeps them out.
         The row places its seven cells in fixed Grid columns, so a collapsed cell costs no
         alignment - that is exactly why this is a Grid and not a UniformGrid (see the row
         template). Do not reach for AutomationProperties.AccessibilityView here: it is a
         UWP/WinUI property, and WPF's own escape hatch (no automation peer) would take the
         entries' accessible names down with it - those names come from the ContentPresenter
         peers that the ItemsControl's peer generates. -->
    <Style x:Key="TimetableCell" TargetType="ItemsControl">
      <Style.Triggers>
        <Trigger Property="HasItems" Value="False">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
      <!-- Not focusable, like every other ItemsControl in the Week tab. An ItemsControl is focusable
           by default, so each one became a nameless tab stop: Tab through a read-only tab landed on
           a run of unnamed List peers. The one intended stop is the ScrollViewer around them, which
           is what scrolls. Focusable is keyboard focus only - the peers, and the entries' accessible
           names that ride on them, are untouched. -->
      <Setter Property="Focusable" Value="False"/>
      <!-- Centred in the row band, with the gutter label beside it. Top-aligned, every row read as
           top-heavy: the text sat under the hairline with the rest of the band empty beneath it. -->
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <!-- The accessible name MUST live here, on the ContentPresenter. A Border at the root of
               the DataTemplate gets no automation peer, so a name set there is dead and every entry
               announces as its class name. -->
          <Style TargetType="ContentPresenter">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate>
            <!-- No box and no time. The row's gutter states the time once and the row's hairline
                 does the containing, so repeating both in every cell only added ink: a near-uniform
                 week drew five identical cards to say "every weekday", each stamped with a time the
                 gutter had already given. A Grid, not a horizontal StackPanel, so the label column
                 is constrained and TextTrimming has a width to trim against. -->
            <StackPanel Margin="2,1,6,1" ToolTip="{Binding DisplayLabel}">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                      <!-- TextMuted, never TextFaint: a disabled entry still has to clear 4.5:1.
                           The dimming is a reinforcement, not the signal - the signal is the glyph
                           beside it and the ", off" on the accessible name. -->
                      <Setter Property="TextElement.Foreground" Value="{StaticResource TextMuted}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <!-- The stacked time, for a lane that shares its cluster. Spends a line of height,
                   which the band has, rather than width, which a ninety-pixel lane has not: inline,
                   the label trimmed to "Focu..." and the cell stopped naming the alarm. Only one of
                   this and the inline copy below is ever visible - see TimetableEntry.StacksTime. -->
              <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource FontMono}"
                         FontSize="{StaticResource TextXs}" Foreground="{StaticResource TextFaint}"
                         Visibility="{Binding StacksTime, Converter={StaticResource BoolToVisible}}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Only when the gutter cannot speak for it, which is a row-level question: a row
                     whose entries all start at 12:15 says 12:15 in its gutter, so the cells stay bare.
                     Only a row holding more than one start time makes its off-boundary entries name
                     themselves - and there the time and the label share a column barely a hundred
                     pixels wide, which is why this is the exception and not the rule.

                     The entry carries the answer (TimetableLayout stamps ShowsTime once the row is
                     known); this must NOT go back to reading the row off an ancestor. It did, and when
                     lanes landed in v2.4.0 the cell moved inside the lane strip, so the walk found a
                     TimetableLane, the condition was never true and every cell time silently vanished
                     - a 12:15 alarm read as 12:00, with the model right and the suite green. -->
                <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource FontMono}"
                           FontSize="{StaticResource TextXs}" Foreground="{StaticResource TextFaint}"
                           Margin="0,0,6,0"
                           Visibility="{Binding InlinesTime, Converter={StaticResource BoolToVisible}}"/>
                <!-- The "off" mark. Segoe Fluent Icons Cancel (E711), the same icon family the sound
                     tags already use. Dimming alone never encodes state (spec 4), so an off entry
                     carries a shape as well as a colour. -->
                <TextBlock Grid.Column="1" Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="{StaticResource TextXs}" Margin="0,0,4,0"
                           Visibility="{Binding IsEnabled, Converter={StaticResource BoolToCollapsed}}"/>
                <!-- DisplayLabel, not Label: an unlabelled alarm is allowed, and it would otherwise
                     draw a blank cell. -->
                <TextBlock Grid.Column="2" Text="{Binding DisplayLabel}" FontSize="{StaticResource TextXs}"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </StackPanel>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The lane strip inside one cell: one column per lane the day draws, left to right, so a
         block's bar keeps the same width down its whole run instead of widening wherever its
         neighbour happens to be absent. A UniformGrid skips a collapsed child and closes the gap,
         so each lane sits in its own Border - the same no-automation-peer trick the day columns use.

         This control is the one automation cost of lanes: an occupied cell now carries a nameless
         list peer around its named entries. An EMPTY cell carries none, because Build hands it no
         lanes at all and HasItems=False collapses this whole subtree - which is what keeps the 105
         empty lists removed on 2026-08-27 from coming back. Accepted deliberately (2026-09-03) as
         the price of drawing overlapping blocks side by side. -->
    <Style x:Key="TimetableLanes" TargetType="ItemsControl">
      <Style.Triggers>
        <Trigger Property="HasItems" Value="False">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate>
            <!-- This Border is the block's bar AND the thing that holds the lane's column open when
                 the band is empty. It has no automation peer, which is what lets a continuation band
                 draw an unbroken bar while announcing nothing: Announced excludes a block's middle
                 and end segments, so the ItemsControl inside has no items there and collapses out of
                 the tree. A three-hour block is therefore one bar and one announcement, not three.

                 The bar never animates when it becomes current, in keeping with the app's
                 reduced-motion posture, and the colour is never the only signal: the entry's
                 accessible name carries the range, and the row's gutter carries the time. -->
            <Border Margin="1,0" MinHeight="18" Padding="0">
              <Border.Style>
                <Style TargetType="Border">
                  <!-- A left stripe, not a fill. A filled bar would put the label on brass and blow
                       the text contrast the palette was chosen for; a stripe reads as one continuous
                       edge down the block's run and leaves the text on the surface it was designed
                       against. Transparent by default so an instant draws no bar at all. -->
                  <Setter Property="BorderThickness" Value="3,0,0,0"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Style.Triggers>
                    <DataTrigger Value="Block">
                      <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource LaneBarState}">
                          <Binding Path="Bar"/>
                          <Binding Path="IsToday"/>
                          <Binding Path="DataContext.Timetable.NowMinuteOfDay"
                                   RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                      </DataTrigger.Binding>
                      <!-- BorderControl, the warm graphite that already clears 3:1 against these
                           surfaces - a filled bar is a non-text element and has to. -->
                      <Setter Property="BorderBrush" Value="{StaticResource BorderControl}"/>
                    </DataTrigger>
                    <DataTrigger Value="Now">
                      <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource LaneBarState}">
                          <Binding Path="Bar"/>
                          <Binding Path="IsToday"/>
                          <Binding Path="DataContext.Timetable.NowMinuteOfDay"
                                   RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                      </DataTrigger.Binding>
                      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <ItemsControl Style="{StaticResource TimetableCell}" ItemsSource="{Binding Announced}"/>
            </Border>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- What the grid could not give a lane to. TextMuted, not TextFaint: it is the only sign those
         entries exist in this rendering, and the agenda below still lists every one of them. -->
    <Style x:Key="TimetableOverflow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource TextXs}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="Margin" Value="2,2,6,1"/>
    </Style>
  </Window.Resources>

  <Grid Margin="{StaticResource WindowPadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- tab headers -->
      <RowDefinition Height="*"/>      <!-- panels, both loaded -->
      <RowDefinition Height="Auto"/>   <!-- running-timer strip -->
      <RowDefinition Height="Auto"/>   <!-- missed-alarm note -->
      <RowDefinition Height="Auto"/>   <!-- undo bar -->
      <RowDefinition Height="Auto"/>   <!-- settings -->
    </Grid.RowDefinitions>

    <TabControl x:Name="Tabs" Grid.Row="0" Style="{StaticResource ShellTabs}"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
      <TabItem Header="Quick timers"/>
      <TabItem Header="Schedule"/>
      <TabItem Header="Week"/>
    </TabControl>

    <Grid x:Name="Panels" Grid.Row="1" Margin="{StaticResource SectionGap}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisible}, ConverterParameter=0}">
        <!-- ONE MEASURE for the whole tab. The cap lives here, on the content panel, so the composer
             card and every alarm row share a maximum width and centre together as one column — the card
             surface hugs its contents and the leftover space is PAGE, not card.

             This is the third layer this cap was tried on, and the first that looks intentional:
             capping the COLUMN pinned the fields left with dead space beside them; capping the FORM
             left a full-width card with a small form floating inside it. HorizontalAlignment stays
             Stretch on purpose — a Stretch element constrained by MaxWidth is CENTRED by WPF, which is
             the whole mechanism.

             The measure is PROPORTIONAL, not fixed - WidthToMeasureConverter clamps 66% of the
             available width between 502 (the form width plus card padding) and 720. A fixed cap
             made a wide window feel ignored: the column froze while the page grew around it. The
             tab strip and the bottom bars sit outside this panel and stay full width, so the
             window still reads as a window. -->
        <StackPanel MaxWidth="{Binding ActualWidth, ElementName=Panels, Converter={StaticResource WidthToMeasure}}" x:Name="QuickPanel">

        <!-- Hero countdown. The accessible name lives on the caption TextBlock: a Border has no
             automation peer. Deliberately NOT a live region - a countdown that announces every
             tick is unusable with a screen reader.
             The hero borrows only the NUMERALS of Running[0]: that row stays in the list below with
             all of its controls (see IsCountdownInHero), so the hero needs no buttons of its own.
             Buttons here would have had to bind StripTimer rather than a captured item, and
             CancelTimer removes that item synchronously - a second click would then have cancelled a
             second timer. Caption, numerals, label. Nothing else. -->
        <!-- Shadow: the caster is a childless sibling BEHIND the card. Hanging the effect on the
             card itself would rasterise the 42px numerals with it. See CardShadowCaster in
             tokens.xaml. Visibility lives on the Grid so the caster collapses with the card. -->
        <Grid Margin="0,0,0,24"
              Visibility="{Binding ShowHero, Converter={StaticResource BoolToVisible}}">
          <Border Style="{StaticResource CardShadowCaster}"/>
          <Border Background="{StaticResource ElevatedBg}" BorderBrush="{StaticResource Border}"
                  BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="16">
            <StackPanel>
              <!-- Caption and accessible name both follow the paused state; the running values are
                   the ones that shipped. -->
              <TextBlock Text="{Binding StripTimer.StateCaption}" Foreground="{StaticResource TextFaint}"
                         FontSize="{StaticResource TextXs}"
                         AutomationProperties.Name="{Binding StripTimer.StateAccessibleName}"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <!-- Mutes to TextMuted while paused, the same treatment (and the same tokens) the row
                     below uses - a frozen clock at 42px has to look stopped, not just say so. -->
                <TextBlock Text="{Binding StripTimer.RemainingText}" FontFamily="{StaticResource FontMono}"
                           FontSize="{StaticResource TextHero}">
                  <TextBlock.Foreground><SolidColorBrush Color="{StaticResource TextColor}"/></TextBlock.Foreground>
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding StripTimer.IsPaused}" Value="True">
                          <DataTrigger.EnterActions>
                            <BeginStoryboard><Storyboard>
                              <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="{StaticResource TextMutedColor}" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard>
                          </DataTrigger.EnterActions>
                          <DataTrigger.ExitActions>
                            <BeginStoryboard><Storyboard>
                              <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="{StaticResource TextColor}" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard>
                          </DataTrigger.ExitActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <!-- The hero's own finish time, sitting beside the numerals rather than under them.
                     VerticalAlignment=Bottom plus a bottom margin of one small-text descender puts
                     its baseline on the numerals' baseline; StackPanel has no baseline alignment of
                     its own. No AutomationProperties.Name: a bare TextBlock already reports its own
                     text to UIA, and adding one here would be a new accessible name. -->
                <TextBlock Text="{Binding StripTimer.FinishText}" Foreground="{StaticResource TextMuted}"
                           FontSize="{StaticResource TextSm}" VerticalAlignment="Bottom"
                           Margin="12,0,0,6"
                           Visibility="{Binding StripTimer.ShowFinish, Converter={StaticResource BoolToVisible}}"/>
              </StackPanel>
              <TextBlock Text="{Binding StripTimer.Label}" Foreground="{StaticResource TextMuted}"
                         FontSize="{StaticResource TextXs}" TextTrimming="CharacterEllipsis"
                         Margin="0,2,0,0"
                         Visibility="{Binding StripTimer.Label, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid>
          <Border Style="{StaticResource CardShadowCaster}"/>
          <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusMd}" Padding="16">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Content="5" Width="64" Command="{Binding StartPresetCommand}" Style="{StaticResource QuietAction}">
                <Button.CommandParameter><sys:Int32>5</sys:Int32></Button.CommandParameter>
              </Button>
              <Button Content="30" Width="64" Command="{Binding StartPresetCommand}" Style="{StaticResource QuietAction}" Margin="10,0,0,0">
                <Button.CommandParameter><sys:Int32>30</sys:Int32></Button.CommandParameter>
              </Button>
              <Button Content="60" Width="64" Command="{Binding StartPresetCommand}" Style="{StaticResource QuietAction}" Margin="10,0,0,0">
                <Button.CommandParameter><sys:Int32>60</sys:Int32></Button.CommandParameter>
              </Button>
            </StackPanel>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding CustomInput, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Custom duration" ToolTip="e.g. 25, 5:00, 1:30:00" Tag="25 min">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding StartCustomCommand}"/></TextBox.InputBindings>
              </TextBox>
              <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Label" Margin="10,0,0,0" Tag="Label">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding StartCustomCommand}"/></TextBox.InputBindings>
              </TextBox>
            </Grid>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Sound" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedSound}"
                        AutomationProperties.Name="Sound for new timers">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SoundLabel}}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="2" Content="&#xE768;" Command="{Binding PreviewSoundCommand}"
                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                      AutomationProperties.Name="Preview sound" ToolTip="Preview sound" Style="{StaticResource QuietAction}" Margin="8,0,0,0"/>
            </Grid>
            <Button Content="Start" Command="{Binding StartCustomCommand}" Style="{StaticResource GoldAction}"
                    HorizontalAlignment="Right" Margin="0,14,0,0" AutomationProperties.Name="Start timer"/>
            <TextBlock Text="{Binding CustomError}" Foreground="{StaticResource Danger}" FontSize="{StaticResource TextXs}"
                       Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                       Visibility="{Binding CustomError, Converter={StaticResource NullToCollapsed}}"/>
          </StackPanel>
          </Border>
        </Grid>

        <ItemsControl ItemsSource="{Binding Running}" Margin="{StaticResource SectionGap}">
          <!-- The hero above renders Running[0]'s countdown, so that ONE row drops its own numerals
               (see the RemainingText TextBlock below) or the number is on screen twice. The row
               itself stays: it keeps pause/reset/cancel bound to its own item, its label, its finish
               time, its sound tag and its IsNext dot, none of which the hero carries. Hiding a
               non-focusable TextBlock is inert; hiding the whole row collapsed a focusable subtree
               out from under the caret every time a resumed timer sorted to the front.
               ItemsSource stays bound to Running itself - a re-projected Running.Skip(1) would hand
               the control a new collection every tick and rebuild every container. -->
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- The caster carries the shadow so the row's own numerals are not rasterised with
                   it; the fade-in moves to the Grid so card and shadow appear together. -->
              <Grid Margin="{StaticResource RowGap}">
                <Grid.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard><Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                    </Storyboard></BeginStoryboard>
                  </EventTrigger>
                </Grid.Triggers>
                <Border Style="{StaticResource CardShadowCaster}"/>
                <Border Background="{StaticResource CardBg}" BorderThickness="1"
                      CornerRadius="{StaticResource RadiusMd}" Padding="16">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsNext}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="&#xE711;"
                          Command="{Binding DataContext.CancelTimerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          AutomationProperties.Name="Cancel timer" ToolTip="Cancel timer" Style="{StaticResource QuietAction}"/>
                  <Button DockPanel.Dock="Right" Content="&#xE72C;" Command="{Binding ResetCommand}"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          AutomationProperties.Name="Reset timer" ToolTip="Reset to full time" Style="{StaticResource QuietAction}" Margin="0,0,8,0"/>
                  <Button DockPanel.Dock="Right" Content="{Binding PauseResumeGlyph}" Command="{Binding PauseResumeCommand}"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          AutomationProperties.Name="{Binding PauseResumeLabel}" ToolTip="{Binding PauseResumeLabel}" Style="{StaticResource QuietAction}" Margin="0,0,8,0"/>
                  <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,2,12,0" VerticalAlignment="Top" Fill="{StaticResource Accent}"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMuted}" FontSize="{StaticResource TextXs}"/>
                    <StackPanel Orientation="Horizontal">
                    <!-- The hero card above already shows this one countdown at 42px, so the row it
                         belongs to hides its own numerals and nothing else. Margin sits here rather
                         than on the finish time so the two close up cleanly when it goes. -->
                    <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource Text2xl}"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsCountdownInHero, Converter={StaticResource BoolToCollapsed}}">
                      <TextBlock.Foreground><SolidColorBrush Color="{StaticResource TextColor}"/></TextBlock.Foreground>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                              <DataTrigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                  <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="{StaticResource TextMutedColor}" Duration="0:0:0.18"/>
                                </Storyboard></BeginStoryboard>
                              </DataTrigger.EnterActions>
                              <DataTrigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                  <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="{StaticResource TextColor}" Duration="0:0:0.18"/>
                                </Storyboard></BeginStoryboard>
                              </DataTrigger.ExitActions>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                      <TextBlock Text="{Binding FinishText}" Foreground="{StaticResource TextFaint}"
                                 FontSize="{StaticResource TextXs}" VerticalAlignment="Center"
                                 AutomationProperties.Name="{Binding FinishText}"
                                 Visibility="{Binding ShowFinish, Converter={StaticResource BoolToVisible}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SoundTag}" Foreground="{StaticResource TextFaint}" FontSize="{StaticResource TextXs}"/>
                  </StackPanel>
                </DockPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        </StackPanel>
      </ScrollViewer>

      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisible}, ConverterParameter=1}">
        <!-- ONE MEASURE for the whole tab. The cap lives here, on the content panel, so the composer
             card and every alarm row share a maximum width and centre together as one column — the card
             surface hugs its contents and the leftover space is PAGE, not card.

             This is the third layer this cap was tried on, and the first that looks intentional:
             capping the COLUMN pinned the fields left with dead space beside them; capping the FORM
             left a full-width card with a small form floating inside it. HorizontalAlignment stays
             Stretch on purpose — a Stretch element constrained by MaxWidth is CENTRED by WPF, which is
             the whole mechanism.

             The measure is PROPORTIONAL, not fixed - WidthToMeasureConverter clamps 66% of the
             available width between 502 (the form width plus card padding) and 720. A fixed cap
             made a wide window feel ignored: the column froze while the page grew around it. The
             tab strip and the bottom bars sit outside this panel and stay full width, so the
             window still reads as a window. -->
        <StackPanel MaxWidth="{Binding ActualWidth, ElementName=Panels, Converter={StaticResource WidthToMeasure}}" x:Name="DayPanel">

        <Grid>
          <Border Style="{StaticResource CardShadowCaster}"/>
          <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusMd}" Padding="16">
          <StackPanel>
            <Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Width="90" x:Name="AlarmTimeBox"
                       Text="{Binding AlarmTimeInput, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Time" ToolTip="24-hour time, e.g. 14:30" Tag="14:30">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddAlarmCommand}"/></TextBox.InputBindings>
              </TextBox>
              <TextBox Grid.Column="1" Text="{Binding AlarmLabel, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Alarm label" Margin="10,0,0,0" Tag="Alarm label">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddAlarmCommand}"/></TextBox.InputBindings>
              </TextBox>
            </Grid>

            <!-- The optional end of a timetable block. Appears only once the alarm repeats: an end
                 is a block's length, and the Week tab draws recurring alarms alone. Empty means an
                 instant, which is what every alarm was before schema 5. -->
            <Grid Margin="0,10,0,0"
                  Visibility="{Binding ShowAlarmEndInput, Converter={StaticResource BoolToVisible}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Ends" VerticalAlignment="Center" Margin="0,0,10,0"
                         Foreground="{StaticResource TextMuted}" FontSize="{StaticResource TextXs}"/>
              <TextBox Grid.Column="1" Width="90" HorizontalAlignment="Left"
                       Text="{Binding AlarmEndInput, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="End time, optional"
                       ToolTip="Optional. 24-hour time, e.g. 10:30" Tag="10:30">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddAlarmCommand}"/></TextBox.InputBindings>
              </TextBox>
            </Grid>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Sound" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding AlarmSound}" AutomationProperties.Name="Alarm sound">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SoundLabel}}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="2" Width="40" HorizontalAlignment="Right" Content="&#xE768;" Command="{Binding PreviewAlarmSoundCommand}"
                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" AutomationProperties.Name="Preview sound"
                      ToolTip="Preview sound" Style="{StaticResource QuietAction}"/>
            </Grid>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Repeat" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding AlarmRepeat}"
                        AutomationProperties.Name="Repeat"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding AlarmDayToggles}" Margin="0,10,0,0"
                          Visibility="{Binding ShowCustomDays, Converter={StaticResource BoolToVisible}}"
                          AutomationProperties.Name="Repeat on">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Style="{StaticResource DayChip}" Content="{Binding Short}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding Full}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox Content="Warn me 5 minutes before" IsChecked="{Binding AlarmWarnBefore}"
                      Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                      AutomationProperties.Name="Warn me 5 minutes before"/>
            <Button Content="Add" Command="{Binding AddAlarmCommand}" Style="{StaticResource GoldAction}"
                    HorizontalAlignment="Right" Margin="0,14,0,0" AutomationProperties.Name="Add alarm"/>
            <TextBlock Text="{Binding AlarmError}" Foreground="{StaticResource Danger}" FontSize="{StaticResource TextXs}"
                       Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                       Visibility="{Binding AlarmError, Converter={StaticResource NullToCollapsed}}"/>
          </StackPanel>
          </Border>
        </Grid>

        <TextBlock Text="Nothing scheduled yet — add an alarm" Foreground="{StaticResource TextFaint}"
                   FontSize="{StaticResource TextSm}" Margin="{StaticResource SectionGap}"
                   Visibility="{Binding IsDayEmpty, Converter={StaticResource BoolToVisible}}"/>

        <ItemsControl ItemsSource="{Binding Alarms}" Margin="{StaticResource SectionGap}">
          <!-- The name belongs on the generated container: a Border has no automation peer, so a name
               set inside the template never reaches the tree and the row falls back to ToString(). -->
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- Shadow on a childless sibling, never on the row itself: an Effect rasterises the
                   whole subtree and would soften the alarm time and every label inside. -->
              <Grid Margin="{StaticResource RowGap}">
                <Grid.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard><Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                    </Storyboard></BeginStoryboard>
                  </EventTrigger>
                </Grid.Triggers>
                <Border Style="{StaticResource CardShadowCaster}"/>
                <Border x:Name="row" Padding="16" CornerRadius="{StaticResource RadiusMd}"
                      Background="{StaticResource CardBg}" BorderThickness="1">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsNext}" Value="True">
                        <Setter Property="Background" Value="{StaticResource ElevatedBg}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderControl}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="&#xE711;"
                          Command="{Binding DataContext.DeleteAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          AutomationProperties.Name="{Binding DeleteLabel}" ToolTip="{Binding DeleteLabel}" Style="{StaticResource DangerAction}"/>
                  <Button DockPanel.Dock="Right" Content="&#xE70F;"
                          Command="{Binding DataContext.BeginEditAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          AutomationProperties.Name="{Binding EditLabel}" ToolTip="{Binding EditLabel}" Style="{StaticResource QuietAction}" Margin="0,0,8,0"/>
                  <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                            IsChecked="{Binding IsEnabled, Mode=OneWay}"
                            Command="{Binding DataContext.ToggleAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            AutomationProperties.Name="{Binding ToggleLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="0,2,12,0" VerticalAlignment="Top" Fill="{StaticResource Accent}"
                             Visibility="{Binding IsNext, Converter={StaticResource BoolToVisible}}"/>
                    <StackPanel>
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                              <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding RangeText}" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource TextLg}" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="{Binding CadenceText}" Foreground="{StaticResource TextFaint}" FontSize="{StaticResource TextXs}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                      </StackPanel>
                      <TextBlock Text="{Binding DisplayLabel}" Foreground="{StaticResource TextMuted}" FontSize="{StaticResource TextXs}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource TextXs}" Foreground="{StaticResource TextFaint}" Margin="0,0,4,0">
                          <TextBlock.Text><Binding Path="HasSound"><Binding.Converter><StaticResource ResourceKey="SoundGlyph"/></Binding.Converter></Binding></TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding SoundText}" Foreground="{StaticResource TextFaint}" FontSize="{StaticResource TextXs}"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        </StackPanel>
      </ScrollViewer>

      <!-- Week: a read-only projection of the recurring alarms. Two renderings of one structure —
           the agenda works at the 380px minimum, the grid needs room. Both are built from
           Timetable.Week; WidthToVisible collapses whichever does not fit.
           Focusable AND IsTabStop so a keyboard user can scroll it: the tab is read-only, so
           without this it contains no tab stop at all and the grid could only ever be read from the
           top. Focusable alone is not enough - ScrollViewer defaults IsTabStop to false, so the
           region accepts focus programmatically but never appears in the tab sequence: Tab from the
           Week header ran straight past it into the unnamed ItemsControls inside, and PageDown did
           nothing because the scroll region never had focus. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="True" IsTabStop="True"
                    AutomationProperties.Name="Week timetable"
                    Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisible}, ConverterParameter=2}">
        <Grid x:Name="WeekPanel" Margin="0,8,0,0">
          <TextBlock Text="No repeating alarms yet — add one on the Schedule tab."
                     Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                     HorizontalAlignment="Center" Margin="16,32,16,32"
                     Visibility="{Binding Timetable.Week.IsEmpty, Converter={StaticResource BoolToVisible}}"/>

          <!-- Both renderings drop out together when there is nothing to draw. Without this gate the
               wide grid still painted seven weekday headers above the "no repeating alarms" line,
               and the agenda still painted today's heading under it. -->
          <Grid Visibility="{Binding Timetable.Week.IsEmpty, Converter={StaticResource BoolToCollapsed}}">

          <!-- Agenda: the narrow rendering, and the one that works at the 380px minimum — and the
               one most people ever see, since the window opens at 440px.
               Days with nothing on them are collapsed: an empty Tuesday heading is noise. Today is
               the exception and always draws, because a week view that silently omits the day you
               are standing in is worse than one empty heading. ShowInAgenda decides that in the
               model, where it is tested, rather than in a converter here. -->
          <ItemsControl Focusable="False" ItemsSource="{Binding Timetable.Week.Days}">
            <ItemsControl.Visibility>
              <!-- The grid's width is not a constant: a day with overlapping blocks divides its
                   column into lanes, and a lane too narrow to hold a label is worse than no grid.
                   RequiredGridWidth decides, in the model, from the week's own widest day. -->
              <MultiBinding Converter="{StaticResource WidthToVisible}" ConverterParameter="Narrow">
                <Binding Path="ActualWidth" ElementName="Panels"/>
                <Binding Path="Timetable.Week.MaxLaneCount"/>
                <Binding Path="Timetable.Week.GridColumnCount"/>
              </MultiBinding>
            </ItemsControl.Visibility>
            <ItemsControl.ItemContainerStyle>
              <!-- Both setters belong on the container. The name because a Border at the root of a
                   DataTemplate gets no automation peer; the visibility because collapsing an inner
                   panel instead would leave a named but empty day sitting in the automation tree. -->
              <Style TargetType="ContentPresenter">
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                <Setter Property="Visibility" Value="{Binding ShowInAgenda, Converter={StaticResource BoolToVisible}}"/>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,16">
                  <!-- Today is marked here exactly as it is in the grid's column headers: a dot AND
                       the brass accent. Colour alone never encodes state (WCAG 1.4.1), and the word
                       "today" is already in the day's accessible name above. -->
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Margin="0,0,4,0" FontSize="{StaticResource TextXs}"
                               Foreground="{StaticResource Accent}"
                               Visibility="{Binding IsToday, Converter={StaticResource BoolToVisible}}"/>
                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource TextXs}">
                      <!-- The default colour is a Setter, not a local attribute: a local value beats
                           a style trigger in WPF, so setting Foreground inline here would make the
                           accent below dead markup. -->
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <!-- The one case a bare heading would not explain: today, with nothing on it. -->
                  <TextBlock Text="Nothing today." Margin="0,4,0,0" FontSize="{StaticResource TextXs}"
                             Foreground="{StaticResource TextMuted}"
                             Visibility="{Binding IsFreeToday, Converter={StaticResource BoolToVisible}}"/>
                  <ItemsControl Focusable="False" ItemsSource="{Binding Entries}" Margin="0,4,0,0">
                    <ItemsControl.ItemContainerStyle>
                      <!-- The accessible name MUST live here, on the ContentPresenter. A Border at
                           the root of the DataTemplate gets no automation peer, so a name set there
                           is dead and every row announces as its class name. -->
                      <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <!-- Border root, not Grid: the disabled-state trigger sets
                             TextElement.Foreground for the whole row, and a Border is the natural
                             carrier for that in both renderings. -->
                        <Border Margin="0,0,0,6" ToolTip="{Binding DisplayLabel}" Background="Transparent">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                  <!-- TextMuted, never TextFaint: a disabled row still has to clear
                                       4.5:1. The dimming reinforces; the signal is the glyph beside
                                       the time and the ", off" on the accessible name. -->
                                  <Setter Property="TextElement.Foreground" Value="{StaticResource TextMuted}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding RangeText}" FontFamily="{StaticResource FontMono}"
                                       Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <!-- The "off" mark. Segoe Fluent Icons Cancel (E711), the same icon
                                 family the sound tags use. Dimming alone never encodes state. -->
                            <TextBlock Grid.Column="1" Text="&#xE711;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextXs}" Margin="0,2,6,0"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding IsEnabled, Converter={StaticResource BoolToCollapsed}}"/>
                            <!-- DisplayLabel, not Label: an unlabelled alarm is allowed and would
                                 otherwise draw a blank line. -->
                            <TextBlock Grid.Column="2" Text="{Binding DisplayLabel}" TextWrapping="Wrap"
                                       MaxHeight="40"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Grid: the wide rendering. A time gutter plus seven day columns, uniform rows from
               Slots.

               ROW-MAJOR, and that is the whole point. One element per slot, holding that slot's
               gutter label AND its seven cells, so a row's label and its entries are the same
               object and physically cannot drift apart. The earlier shape — a gutter ItemsControl
               over Slots beside seven day ItemsControls over Entries — shared no row structure at
               all: entries stacked from the top in list order, so a 15:00 alarm drew level with
               the gutter's 07:30 and two alarms three hours apart read as simultaneous.

               The obvious repair, a per-day Rows collection with a fixed row height in the gutter
               and in every column, is rejected twice over: it needs the same magic number in eight
               places to stay aligned, and it generates a container per slot per column — the 48x7
               lattice of blanks spec §6 forbids. Here the only per-slot containers are the rows
               themselves, and an empty cell generates nothing at all.

               No arithmetic here: TimetableLayout.Build already decided which row each alarm is
               in, and this draws the rows it was handed. -->
          <StackPanel Grid.IsSharedSizeScope="True">
            <StackPanel.Visibility>
              <!-- The other half of the same decision — see the agenda's binding above. -->
              <MultiBinding Converter="{StaticResource WidthToVisible}" ConverterParameter="Wide">
                <Binding Path="ActualWidth" ElementName="Panels"/>
                <Binding Path="Timetable.Week.MaxLaneCount"/>
                <Binding Path="Timetable.Week.GridColumnCount"/>
              </MultiBinding>
            </StackPanel.Visibility>

            <!-- Day headers. The same two-column shape as a row, with the gutter column in the same
                 shared-size group, so the headers sit over the columns they name however wide the
                 gutter's labels turn out to be. The header's own gutter cell is empty on purpose —
                 the group takes its width from the rows.

                 The headings are chrome and the rows are the data, so they are separated three
                 ways: a rule in BorderControl, twice as bright as the rows' own hairlines; the
                 muted text colour the rest of the app gives its captions; and a clear band of space
                 before the first row. One of the three alone left the two reading as one block. -->
            <Border BorderBrush="{StaticResource BorderControl}" BorderThickness="0,0,0,1"
                    Padding="0,0,0,6" Margin="0,0,0,4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="TimetableGutter"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <!-- GridDays, not Days: the grid gives the weekend columns only when the weekend has
                   something on it, and a heading over a column that is not drawn would put every
                   name one place out. -->
              <ItemsControl Focusable="False" Grid.Column="1" ItemsSource="{Binding Timetable.Week.GridDays}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="ContentPresenter">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- Left, not centred, and on the cells' own left margin: the entries below
                         are left-aligned text now that they have no boxes filling the column, so a
                         centred heading floats half a column to the right of what it names. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="2,0,0,0">
                      <!-- Today is marked by a glyph as well as the accent: colour alone never
                           encodes state (WCAG 1.4.1). -->
                      <TextBlock Text="●" Margin="0,0,4,0" Foreground="{StaticResource Accent}"
                                 Visibility="{Binding IsToday, Converter={StaticResource BoolToVisible}}"/>
                      <TextBlock Text="{Binding Name}" FontSize="{StaticResource TextXs}"
                                 FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            <Style.Triggers>
                              <!-- Today's name takes the accent as well as the dot beside it. The
                                   dot is what carries the meaning; the colour only reinforces it
                                   (WCAG 1.4.1). -->
                              <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
            </Border>

            <!-- The rows themselves. -->
            <ItemsControl Focusable="False" ItemsSource="{Binding Timetable.Week.Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- The hairline is the row structure now that the cells carry no boxes of
                       their own. It runs the full width, gutter included, so a time can be followed
                       across the seven days.

                       MinHeight is the ONE row-height value in this rendering, and because the
                       gutter label and all seven cells live inside this Grid it governs every one
                       of them at once. Every row is the same height and its content is centred in
                       it: the rows carry one line each, they are the only rows there are now that
                       an empty half hour draws nothing, and an even rhythm is what makes the panel
                       read as a timetable. MinHeight rather than Height so a half hour holding two
                       alarms still grows - and it grows across the whole width, so the gutter stays
                       in line. -->
                  <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                  <Grid MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="TimetableGutter"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- GutterLabel, not Slot.Label: the slot is a half-hour band, and a row of
                         12:15 alarms would be read off the band as 12:00. The row states the time
                         its entries actually start at whenever they agree on one, which is the
                         ordinary case - a class repeating on several days. No thinning of the
                         labels either: every row here has an alarm in it, so blanking a label would
                         take that alarm's only time off the tab. -->
                    <TextBlock Text="{Binding GutterLabel}" Margin="0,0,10,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource FontMono}" FontSize="{StaticResource TextXs}"
                               Foreground="{StaticResource TextFaint}"/>

                    <!-- One equal column per VISIBLE child, in order, which is the alignment rule
                         now that the number of columns varies: a UniformGrid with Rows="1" splits
                         the width between the children it is actually drawing, left to right, so
                         Monday can only ever be first and the weekend can only ever be last. The
                         header strip above splits the same width the same way over GridDays, so the
                         two agree by construction rather than by a shared magic number.

                         The Borders are what hold the columns open. A Border gets no automation
                         peer - the one WPF fact this file leans on twice - so an empty cell can
                         still occupy its share of the width while the ItemsControl inside it
                         collapses out of the automation tree, which is what a UniformGrid could not
                         survive on its own: it skips a collapsed child and closes the gap. That is
                         also exactly how the weekend is dropped, deliberately, below. -->
                    <UniformGrid Grid.Column="1" Rows="1">
                      <Border><StackPanel><ItemsControl Style="{StaticResource TimetableLanes}" ItemsSource="{Binding Cells[0].Lanes}"/><TextBlock Style="{StaticResource TimetableOverflow}" Text="{Binding Cells[0].OverflowText}" Visibility="{Binding Cells[0].HasOverflow, Converter={StaticResource BoolToVisible}}"/></StackPanel></Border>
                      <Border><StackPanel><ItemsControl Style="{StaticResource TimetableLanes}" ItemsSource="{Binding Cells[1].Lanes}"/><TextBlock Style="{StaticResource TimetableOverflow}" Text="{Binding Cells[1].OverflowText}" Visibility="{Binding Cells[1].HasOverflow, Converter={StaticResource BoolToVisible}}"/></StackPanel></Border>
                      <Border><StackPanel><ItemsControl Style="{StaticResource TimetableLanes}" ItemsSource="{Binding Cells[2].Lanes}"/><TextBlock Style="{StaticResource TimetableOverflow}" Text="{Binding Cells[2].OverflowText}" Visibility="{Binding Cells[2].HasOverflow, Converter={StaticResource BoolToVisible}}"/></StackPanel></Border>
                      <Border><StackPanel><ItemsControl Style="{StaticResource TimetableLanes}" ItemsSource="{Binding Cells[3].Lanes}"/><TextBlock Style="{StaticResource TimetableOverflow}" Text="{Binding Cells[3].OverflowText}" Visibility="{Binding Cells[3].HasOverflow, Converter={StaticResource BoolToVisible}}"/></StackPanel></Border>
                      <Border><StackPanel><ItemsControl Style="{StaticResource TimetableLanes}" ItemsSource="{Binding Cells[4].Lanes}"/><TextBlock Style="{StaticResource TimetableOverflow}" Text="{Binding Cells[4].OverflowText}" Visibility="{Binding Cells[4].HasOverflow, Converter={StaticResource BoolToVisible}}"/></StackPanel></Border>
                      <!-- Saturday and Sunday, dropped as a pair on a week with a free weekend. The
                           week decides it once (HidesWeekend) and every row reads the same answer,
                           so no row can end up a column wider than its neighbours. -->
                      <Border Visibility="{Binding DataContext.Timetable.Week.HidesWeekend, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToCollapsed}}"><StackPanel><ItemsControl Style="{StaticResource TimetableLanes}" ItemsSource="{Binding Cells[5].Lanes}"/><TextBlock Style="{StaticResource TimetableOverflow}" Text="{Binding Cells[5].OverflowText}" Visibility="{Binding Cells[5].HasOverflow, Converter={StaticResource BoolToVisible}}"/></StackPanel></Border>
                      <Border Visibility="{Binding DataContext.Timetable.Week.HidesWeekend, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToCollapsed}}"><StackPanel><ItemsControl Style="{StaticResource TimetableLanes}" ItemsSource="{Binding Cells[6].Lanes}"/><TextBlock Style="{StaticResource TimetableOverflow}" Text="{Binding Cells[6].OverflowText}" Visibility="{Binding Cells[6].HasOverflow, Converter={StaticResource BoolToVisible}}"/></StackPanel></Border>
                    </UniformGrid>
                  </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- What the grid left out, said rather than left to be noticed. A TextBlock, so it is
                 announced with the rest of the panel: a screen reader cannot see two missing
                 columns. It only appears when the columns are actually gone. -->
            <TextBlock Text="Weekend — nothing scheduled" Margin="0,12,0,0"
                       FontSize="{StaticResource TextXs}" Foreground="{StaticResource TextFaint}"
                       Visibility="{Binding Timetable.Week.HidesWeekend, Converter={StaticResource BoolToVisible}}"/>
          </StackPanel>
          </Grid>   <!-- /the IsEmpty gate around both renderings -->
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- No shadow caster here on purpose: the strip is recessed chrome on PanelBg, a hair BELOW the
         page in intent, and a drop shadow would claim it floats above it. -->
    <Border Grid.Row="2" Margin="{StaticResource SectionGap}"
            Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="12"
            Visibility="{Binding ShowStrip, Converter={StaticResource BoolToVisible}}">
      <!-- The name belongs on the TextBlock caption: a Border has no automation peer, so a name
           set on it never reaches the tree. No LiveSetting, no bound Name, no storyboard.
           The caption's visible text stays short ("Running") for the glance; its accessible name is
           the longer "Running timer" so it still makes sense read alone, without the dot beside it
           for context — don't "simplify" the two into agreeing text. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>   <!-- dot -->
          <ColumnDefinition Width="Auto"/>   <!-- "Running" caption -->
          <ColumnDefinition Width="Auto"/>   <!-- remaining time -->
          <ColumnDefinition Width="*"/>      <!-- label: free text up to 200 chars, trims instead of pushing the rest off -->
          <ColumnDefinition Width="Auto"/>   <!-- "+N more" -->
        </Grid.ColumnDefinitions>
        <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,10,0" Fill="{StaticResource Accent}"/>
        <TextBlock Grid.Column="1" Text="Running" Foreground="{StaticResource TextMuted}" FontSize="{StaticResource TextXs}"
                   VerticalAlignment="Center" Margin="0,0,10,0"
                   AutomationProperties.Name="Running timer"/>
        <TextBlock Grid.Column="2" Text="{Binding StripTimer.RemainingText}" FontFamily="{StaticResource FontMono}"
                   FontSize="{StaticResource TextLg}" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{Binding StripTimer.Label}" Foreground="{StaticResource TextMuted}"
                   FontSize="{StaticResource TextXs}" VerticalAlignment="Center" Margin="10,0,0,0"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding StripTimer.Label, Converter={StaticResource NullToCollapsed}}"/>
        <TextBlock Grid.Column="4" Text="{Binding StripExtraText}" Foreground="{StaticResource TextFaint}"
                   FontSize="{StaticResource TextXs}" VerticalAlignment="Center" Margin="10,0,0,0"
                   Visibility="{Binding StripExtraText, Converter={StaticResource NullToCollapsed}}"/>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="{StaticResource SectionGap}"
          Visibility="{Binding MissedNote, Converter={StaticResource NullToCollapsed}}">
      <Border Style="{StaticResource CardShadowCaster}"/>
      <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="16">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="&#xE711;" Command="{Binding DismissMissedNoteCommand}"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                AutomationProperties.Name="Dismiss missed note" Style="{StaticResource QuietAction}"/>
        <TextBlock Text="{Binding MissedNote}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
      </Border>
    </Grid>

    <!-- LiveSetting stays on the Border that holds the announced text, not on the wrapper Grid:
         moving it would change which element UIA reports the polite update from. -->
    <Grid Grid.Row="4" Margin="{StaticResource SectionGap}"
          Visibility="{Binding PendingDeleteLabel, Converter={StaticResource NullToCollapsed}}">
      <Border Style="{StaticResource CardShadowCaster}"/>
      <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}" Padding="16"
            AutomationProperties.LiveSetting="Polite">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Undo" Command="{Binding UndoDeleteCommand}"
                AutomationProperties.Name="Undo delete" Style="{StaticResource QuietAction}"/>
        <TextBlock Text="{Binding PendingDeleteLabel}" Foreground="{StaticResource TextMuted}"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
      </Border>
    </Grid>

    <Button Grid.Row="5" Content="Settings" HorizontalAlignment="Left" Click="OnSettings" Style="{StaticResource QuietAction}" Margin="{StaticResource SectionGap}"/>
  </Grid>
</Window>
