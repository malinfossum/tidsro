<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:v="clr-namespace:Tidsro.Views">

  <v:NullToCollapsedConverter x:Key="NullToCollapsed"/>
  <v:BoolToVisibleConverter x:Key="BoolToVisible"/>
  <v:BoolToCollapsedConverter x:Key="BoolToCollapsed"/>
  <v:SoundChoiceToLabelConverter x:Key="SoundLabel"/>
  <v:BoolToSoundGlyphConverter x:Key="SoundGlyph"/>
  <v:IndexToVisibleConverter x:Key="IndexToVisible"/>
  <v:WidthToMeasureConverter x:Key="WidthToMeasure"/>
  <v:WidthToVisibleConverter x:Key="WidthToVisible"/>
  <v:SlotLabelConverter x:Key="SlotLabel"/>

  <!-- Surfaces — neutral, and lifted just off black so SHADOWS ACTUALLY RENDER. Three waves got
       here: walnut brown (rejected twice, §14 of the spec), then true black #000000, which killed
       every shadow in the app — CardShadow casts #000000, so on a #000000 page it is arithmetically
       invisible and nothing lifted. PageBg is #0A0A0A for exactly that reason. Do not put it back
       to pure black without also replacing the shadow with a light rim; the two are one decision.

       The ladder now runs in BOTH directions from the card, which is what makes the app read as
       built rather than flat:
         - PageBg #0A0A0A -> PanelBg #141414 -> CardBg #1E1E1E -> ElevatedBg #262626, rising.
         - InteractiveBg #0E0E0E sits BELOW CardBg on purpose. Text boxes, combos and quiet
           buttons are INSET: a field you type into should read as a well cut into the card, not
           as another card stacked on it. That single inversion is most of the depth in the form.
       Separation therefore comes from real lightness steps, a visible #3A3A3A hairline, the lit
       top edge baked into CardBg/ElevatedBg below, and CardShadow (§7.5) which now has somewhere
       to darken into.

       Still true from the earlier waves: no per-step lightness MINIMA (they are what drove the
       palette to dusty pink), and surfaces carry NO hue — all warmth lives in Accent and the text.
       §5/§8 of the design spec hold the contrast table — recompute it before nudging any value. -->
  <SolidColorBrush x:Key="PageBg"     Color="#0A0A0A"/>
  <SolidColorBrush x:Key="PanelBg"    Color="#141414"/>
  <!-- CardBg and ElevatedBg are GRADIENTS, not flat fills. The first ~3% of their height carries a
       lit top edge; below that they are the flat base colour. Shadow says "this sits below", a lit
       edge says "this sits above" — together the card reads as a physical object catching light
       from the top of the window, which flat fills plus a shadow never quite do.

       The highlight is deliberately confined to the top 3%, which on every surface in the app lands
       INSIDE CardPadding. No text ever renders on it, so the §8 table measures against the flat base
       colours and stays valid. Widening that stop would put body text on a lighter background and
       break TextFaint — it clears 4.5:1 on #1E1E1E and #262626, not on the highlight. -->
  <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0"     Color="#2E2E2E"/>
    <GradientStop Offset="0.035" Color="#1E1E1E"/>
    <GradientStop Offset="1"     Color="#1E1E1E"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ElevatedBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0"     Color="#363636"/>
    <GradientStop Offset="0.035" Color="#262626"/>
    <GradientStop Offset="1"     Color="#262626"/>
  </LinearGradientBrush>

  <!-- Any colour a ControlTemplate ANIMATES must exist as a Color resource. A Storyboard's To=
       takes a Color, so writing a literal there silently survives a palette change - which is
       exactly how the gold button kept its old gold. Colors are structs, so seeding an inline
       (unfrozen) brush from one keeps the brush animatable. -->
  <Color x:Key="InteractiveBgColor">#0E0E0E</Color>
  <Color x:Key="InteractiveHoverColor">#191919</Color>
  <SolidColorBrush x:Key="InteractiveBg"    Color="{StaticResource InteractiveBgColor}"/>
  <SolidColorBrush x:Key="InteractiveHover" Color="{StaticResource InteractiveHoverColor}"/>

  <!-- Text — warm white and warm greys, at low chroma. This is where the warmth that used to be
       smeared across every surface now lives, together with the accent. Keep the chroma low: the
       rejected palette's muted text was #C0AB93, a tan with 45 points between its red and blue
       channels, and at body-copy size that is what "washed out" looked like. These sit under 15.
       TextFaint is the floor token — it renders on ElevatedBg, the lightest surface carrying body
       text, and measures 4.60 there and 5.35 on InteractiveHover. -->
  <Color x:Key="TextColor">#F4F1EC</Color>
  <Color x:Key="TextMutedColor">#B0A9A0</Color>
  <SolidColorBrush x:Key="Text"      Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
  <SolidColorBrush x:Key="TextFaint" Color="#938D85"/>

  <!-- Lines, split by job. Border is ornament; BorderControl is the affordance, so it carries the
       3:1 non-text contrast WCAG 1.4.11 asks for - on every surface it is actually drawn on,
       including the InteractiveHover fill a QuietAction animates to underneath it.
       BorderControl is warm graphite, not neutral grey, and deliberately sits just above the gate
       rather than well over it - a mid-grey loud enough to be seen from across the window is what
       "washed out" looks like. Its floor is ElevatedBg at 3.18:1, which is what stops it going any
       dimmer: the hero and next-alarm row are the lightest things it is drawn on. Tightest text
       pair: TextFaint on ElevatedBg at 4.60:1.
       Recompute all three before nudging any of these values darker. -->
  <SolidColorBrush x:Key="Border"        Color="#3A3A3A"/>
  <SolidColorBrush x:Key="BorderControl" Color="#78726B"/>

  <!-- Accent + semantic. Accent is the gold that already sits in Assets/icons/tidsro.svg, so the
       UI and the app's own mark are the same colour - the icon is brand and the UI follows it,
       not the reverse. Do not drift one without the other. -->
  <Color x:Key="AccentColor">#E3B341</Color>
  <Color x:Key="AccentStrongColor">#F0C55C</Color>
  <SolidColorBrush x:Key="Accent"       Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentStrong" Color="{StaticResource AccentStrongColor}"/>
  <SolidColorBrush x:Key="Danger"       Color="#D9736A"/>

  <!-- Toggle internals. An earlier wave moved the armed-alarm state onto a green so gold could mean
       "action" alone; Malin likes the gold toggle, so gold does both jobs again and the green is
       deleted rather than left unused. What keeps six armed alarms from reading as a gold column is
       the SHAPE, not the hue: the track stays a near-black well with a gold ring and a soft gold
       halo, so the eye sees six lit outlines instead of six filled slabs. ToggleWell is darker than
       any surface on purpose — it is the hole the ring sits in. -->
  <SolidColorBrush x:Key="ToggleWell" Color="#050505"/>
  <DropShadowEffect x:Key="ToggleGlow" ShadowDepth="0" BlurRadius="10"
                    Color="{StaticResource AccentColor}" Opacity="0.45" RenderingBias="Performance"/>

  <!-- Spacing (DIP). Space1-4 are INSIDE controls; Space5 and up are BETWEEN sections. The gaps
       between major blocks are part of how the surfaces separate now that the ladder no longer
       leans on lightness, so widening them is a palette decision, not just a layout one. Padding
       inside controls is deliberately unchanged. -->
  <sys:Double x:Key="Space1">4</sys:Double>
  <sys:Double x:Key="Space2">8</sys:Double>
  <sys:Double x:Key="Space3">12</sys:Double>
  <sys:Double x:Key="Space4">16</sys:Double>
  <sys:Double x:Key="Space5">24</sys:Double>
  <sys:Double x:Key="Space6">32</sys:Double>
  <Thickness x:Key="CardPadding">16</Thickness>
  <!-- Section rhythm, expressed as Thicknesses so MainWindow can use the tokens directly rather
       than repeating magic numbers in a Margin string. -->
  <Thickness x:Key="WindowPadding">32</Thickness>
  <Thickness x:Key="SectionGap">0,24,0,0</Thickness>
  <Thickness x:Key="RowGap">0,0,0,16</Thickness>

  <!-- Radius -->
  <CornerRadius x:Key="RadiusSm">8</CornerRadius>
  <CornerRadius x:Key="RadiusMd">12</CornerRadius>
  <CornerRadius x:Key="RadiusLg">16</CornerRadius>

  <!-- Elevation.

       THE TRAP: setting Effect on an element rasterises that element AND ITS ENTIRE SUBTREE into an
       intermediate bitmap. Every glyph inside loses ClearType sub-pixel antialiasing and renders
       visibly softer - on a timer app whose numerals ARE the product, that is a real cost. So the
       shadow must never hang on a Border that contains content.

       Instead: CardShadowCaster is a childless, background-only Border that sits BEHIND the content
       Border with identical geometry (same Grid cell, same CornerRadius). It carries the effect and
       casts the halo; the content Border stays effect-free and its text stays crisply rendered.
       The caster is filled with PageBg, so where the content Border's antialiased corners are
       partly transparent, what shows through is exactly the page colour that would have been there
       anyway - the caster is invisible and only its shadow is seen. IsHitTestVisible=False keeps it
       out of the input path.

       A black shadow on a #0B0908 page can only darken by ~11 units, so this is inherently a soft
       grounding halo rather than a Material elevation step. That is the intent - Tidsro is a calm
       app. Adjust Opacity here to taste; do NOT reach for the content Border's Effect instead. -->
  <DropShadowEffect x:Key="CardShadow" BlurRadius="30" ShadowDepth="8" Direction="270"
                    Opacity="0.95" Color="#000000" RenderingBias="Performance"/>

  <Style x:Key="CardShadowCaster" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PageBg}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <!-- Typography -->
  <!-- pack:// so the embedded family is used rather than a machine-installed one. The trailing
       slash before # is required. Segoe UI / Consolas stay as fallbacks so a packaging mistake
       degrades instead of crashing - but a fallback is exactly how "Inter" went unnoticed, so this
       is checked from three angles: FontResourceTests proves the .ttf files are embedded; proves
       each token's own location and family name - re-resolved through Tidsro.dll, since a test
       host can't be pointed at it any other way - actually returns IBM Plex's real typefaces
       rather than an empty or Segoe-UI/Consolas result; and proves WPF can see both families at
       the pack base URI. The manual pass covers what automated coverage still can't (visual
       weight rendering, no jitter). -->
  <FontFamily x:Key="FontSans">pack://application:,,,/Assets/fonts/#IBM Plex Sans, Segoe UI</FontFamily>
  <FontFamily x:Key="FontMono">pack://application:,,,/Assets/fonts/#IBM Plex Mono, Consolas</FontFamily>
  <sys:Double x:Key="TextXs">12</sys:Double>
  <sys:Double x:Key="TextSm">14</sys:Double>
  <sys:Double x:Key="TextMd">16</sys:Double>
  <sys:Double x:Key="TextLg">18</sys:Double>
  <sys:Double x:Key="TextXl">20</sys:Double>
  <sys:Double x:Key="Text2xl">28</sys:Double>
  <sys:Double x:Key="TextHero">42</sys:Double>

  <!-- Motion -->
  <Duration x:Key="DurationFast">0:0:0.12</Duration>
  <Duration x:Key="DurationBase">0:0:0.18</Duration>
  <Duration x:Key="DurationSlow">0:0:0.26</Duration>

  <!-- Keyboard-only focus ring: a FocusVisualStyle renders for keyboard navigation, never for mouse clicks. -->
  <Style x:Key="ActionFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border CornerRadius="8" BorderThickness="1.5" BorderBrush="{StaticResource AccentStrong}" Margin="-1.5"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Button styles -->
  <Style x:Key="QuietAction" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource ActionFocusVisual}"/>
    <Setter Property="Background" Value="{StaticResource InteractiveBg}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderControl}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="{StaticResource TextSm}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="8"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <Border.Background><SolidColorBrush Color="{StaticResource InteractiveBgColor}"/></Border.Background>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard>
                  <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Background.Color"
                                  To="{StaticResource InteractiveHoverColor}" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard>
                  <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Background.Color"
                                  To="{StaticResource InteractiveBgColor}" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity"
                                   To="0.85" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity"
                                   To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Destructive variant of QuietAction. Red on HOVER ONLY: a schedule showing six delete buttons
       permanently in red reads as six errors. The outline and glyph carry it — the fill still
       animates through the QuietAction storyboard, so nothing here fights that. -->
  <Style x:Key="DangerAction" TargetType="Button" BasedOn="{StaticResource QuietAction}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Primary action: the one gold button per surface (Start, Add/Save). -->
  <Style x:Key="GoldAction" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource ActionFocusVisual}"/>
    <Setter Property="Background" Value="{StaticResource Accent}"/>
    <Setter Property="Foreground" Value="{StaticResource PageBg}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="FontSize" Value="{StaticResource TextSm}"/>
    <!-- The one weight step in the button set: primary actions carry it, QuietAction stays Regular. -->
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <Border.Background><SolidColorBrush Color="{StaticResource AccentColor}"/></Border.Background>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard>
                  <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Background.Color"
                                  To="{StaticResource AccentStrongColor}" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard>
                  <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Background.Color"
                                  To="{StaticResource AccentColor}" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dark text input with a placeholder hint (set via Tag) -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource InteractiveBg}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderControl}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FontSize" Value="{StaticResource TextSm}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
              <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextFaint}"
                         Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                         Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value=""/>
                <Condition Property="IsKeyboardFocused" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentStrong}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dark ComboBox: the default popup is light-on-dark and illegible. Restyle the toggle + items. -->
  <Style x:Key="ComboItem" TargetType="ComboBoxItem">
    <Setter Property="Background" Value="{StaticResource ElevatedBg}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource InteractiveBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Background" Value="{StaticResource InteractiveBg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderControl}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{StaticResource InteractiveBg}" BorderBrush="{StaticResource BorderControl}"
                          BorderThickness="1" CornerRadius="8" Padding="8,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        TextElement.Foreground="{StaticResource Text}"
                                        VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
              <Border Background="{StaticResource ElevatedBg}" BorderBrush="{StaticResource Border}"
                      BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ItemsPresenter/>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Day-of-week toggle chip: Custom-day picker in the Schedule editor. Selected = gold fill (a fill
       change, not colour alone); each chip keeps its full-day AutomationProperties.Name + ToggleButton
       pressed state for screen readers. -->
  <Style x:Key="DayChip" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource ActionFocusVisual}"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Margin" Value="3,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    <Setter Property="FontSize" Value="{StaticResource TextSm}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="chip" CornerRadius="{StaticResource RadiusSm}" BorderThickness="1"
                  Background="{StaticResource InteractiveBg}" BorderBrush="{StaticResource BorderControl}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="chip" Property="Background" Value="{StaticResource Accent}"/>
              <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter Property="Foreground" Value="{StaticResource PageBg}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AccentStrong}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toggle switch for boolean settings (warn-before, launch-at-startup). Restyles CheckBox so the
       IsChecked binding and screen-reader checked/unchecked semantics carry over unchanged. State reads
       from thumb POSITION (not colour alone); gold-when-on echoes the primary action. -->
  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource ActionFocusVisual}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontSize" Value="{StaticResource TextSm}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="track" Width="42" Height="24" CornerRadius="12" VerticalAlignment="Center"
                    Background="{StaticResource InteractiveBg}" BorderBrush="{StaticResource BorderControl}" BorderThickness="1">
              <Ellipse x:Name="thumb" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="3,0,0,0" Fill="{StaticResource TextMuted}"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{StaticResource ToggleWell}"/>
              <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter TargetName="track" Property="BorderThickness" Value="2"/>
              <Setter TargetName="track" Property="Effect" Value="{StaticResource ToggleGlow}"/>
              <Setter TargetName="thumb" Property="Fill" Value="{StaticResource AccentStrong}"/>
              <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AccentStrong}"/>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="False"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Text}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tab headers. The stock TabControl chrome is light-themed and unusable on PageBg, so both the
       control and its items are templated end to end. Selected state reads from the gold underline,
       not colour alone; 34px minimum height matches TextBox/ComboBox/DayChip so the app's only
       navigation control is not also its smallest mouse target. -->
  <Style x:Key="ShellTabItem" TargetType="TabItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource ActionFocusVisual}"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="{StaticResource TextSm}"/>
    <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2"
                  BorderBrush="Transparent" Padding="{TemplateBinding Padding}"
                  MinHeight="{TemplateBinding MinHeight}">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
              <!-- Weight is the third cue after the underline and the foreground lift, and it is a
                   real embedded face (IBMPlexSans-SemiBold), not a synthesised bold - FontResourceTests
                   pins that, because a missing face degrades silently into faux-bold. -->
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Header-only: the template deliberately has no content host, so both shell panels can live
       outside the control and stay loaded. TabItem still reports as a tab to UIA. -->
  <Style x:Key="ShellTabs" TargetType="TabControl">
    <Setter Property="ItemContainerStyle" Value="{StaticResource ShellTabItem}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scrollbar. Stepper buttons are dropped deliberately: the lists are short and both the wheel
       and the keyboard scroll the panel, so the arrows are redundant here. The thumb keeps a 40px
       minimum length and the track a 16px hit area (wider than it looks) so it stays a usable
       pointer target under WCAG 2.5.8. -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <!-- Transparent padding grows the target without adding visual weight. -->
          <Border Background="Transparent" Padding="5,0">
            <Border x:Name="bar" CornerRadius="3" Background="{StaticResource BorderControl}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bar" Property="Background" Value="{StaticResource TextFaint}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="MinWidth" Value="16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" MinHeight="40"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
